# 腾讯云访问凭证。不要把真实值提交到 Git。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# 腾讯云短信应用与已审核签名。
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=

# 分别申请两个固定内容模板，避免让模型发送任意文本。
TENCENT_SMS_MORNING_TEMPLATE_ID=
TENCENT_SMS_AFTERNOON_TEMPLATE_ID=

# 仅允许这个中国大陆手机号。必须使用 E.164 格式，例如 +8613800138000。
TENCENT_SMS_ALLOWED_TO=

# 固定模板不需要变量时保留 []。
TENCENT_SMS_MORNING_PARAMS_JSON=[]
TENCENT_SMS_AFTERNOON_PARAMS_JSON=[]

# 安全默认值：true 只预演，不请求腾讯云。完成测试后再改成 false。
TENCENT_SMS_DRY_RUN=true

# 通常无需修改。
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_ENDPOINT=sms.tencentcloudapi.com
